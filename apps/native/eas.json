{
  "cli": {
    "appVersionSource": "remote"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "environment": "preview",
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "distribution": "store",
      "environment": "production",
      "ios": {
        "autoIncrement": true
      },
      "env": {
        "EXPO_PUBLIC_WEB_URL": "https://movies.emmut.space",
        "EXPO_PUBLIC_PASSKEY_DOMAIN": "movies.emmut.space"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {}
    }
  }
}
