# Optional overrides. Leave empty for local development: URLs follow the browser/Expo host.
# Release builds require both HTTPS origins; OAuth starts and returns on the web origin.
# Production: https://api-production-3512ca78.up.railway.app
EXPO_PUBLIC_SERVER_URL=
# Production: https://movies.emmut.space
EXPO_PUBLIC_WEB_URL=

# Required for passkeys in a custom signed build (not Expo Go).
EXPO_PUBLIC_PASSKEY_DOMAIN=
