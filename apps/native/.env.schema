# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# Leave empty to derive the API address from the browser or Expo host.
# @public @optional @type=url(allowedProtocols=[http, https])
EXPO_PUBLIC_SERVER_URL=

# Leave empty to derive the existing web app's address from the development host.
# @public @optional @type=url(allowedProtocols=[http, https])
EXPO_PUBLIC_WEB_URL=

# Canonical HTTPS web auth hostname associated with the signed native app.
# @public @optional @type=string(matches=regex("^[A-Za-z0-9](?:[A-Za-z0-9.-]*[A-Za-z0-9])?$"))
EXPO_PUBLIC_PASSKEY_DOMAIN=

# EAS supplies the selected profile during a signed build.
# @public @optional @type=string(minLength=1)
EAS_BUILD_PROFILE=
