MOVIE_DB_ACCESS_TOKEN=
PORT=3001
# Optional locally (localhost/private LAN browser origins allowed).
# Required for a production browser client: set its exact origin.
# CORS_ORIGIN=https://app.example.com

# Same database as web, with migrations and the nightly search index applied.
# Optional: without it, search gracefully uses TMDB alone.
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/movies
DB_POOL_MAX=3

# Request logging verbosity: trace, debug, info, warn, error, silent.
LOG_LEVEL=info
