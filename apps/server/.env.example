MOVIE_DB_ACCESS_TOKEN=
PORT=3001
# Optional locally (localhost/private LAN browser origins allowed).
# Required for a production browser client: set its exact origin.
# CORS_ORIGIN=https://app.example.com

# Same database as web, with migrations and the nightly search index applied.
# Optional: without it, search gracefully uses TMDB alone.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/movies
DB_POOL_MAX=3

# Request logging verbosity: trace, debug, info, warn, error, silent.
LOG_LEVEL=info

# Public web origin: Next proxies auth to Hono, preserving cookies and callback URLs.
BETTER_AUTH_URL=http://localhost:3000
# Copy the existing web BETTER_AUTH_SECRET to keep issued sessions valid.
BETTER_AUTH_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
AUTH_IP_SOURCE=socket
# Must match web BETTER_AUTH_SECRET for proxy metadata/cache invalidation.
AUTH_PROXY_SECRET=
# AUTH_RATE_LIMIT_DISABLED=true # local/e2e only
# BETTER_AUTH_TRUSTED_ORIGIN=
# PASSKEY_ANDROID_FINGERPRINTS=

# Deliver account cache invalidation for writes from both clients.
WEB_URL=http://localhost:3000
