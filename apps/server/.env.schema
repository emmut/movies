# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# TMDB API read access token; never sent to native clients.
# @type=string(minLength=1, matches=regex("[A-Za-z0-9]"))
MOVIE_DB_ACCESS_TOKEN=

# @public @type=port(min=1)
PORT=3001

# Optional locally; production browser consumers must supply their exact origin.
# @public @optional @type=url(allowedProtocols=[http, https], matches=regex("^https?://[^/?#@]+/?$"))
CORS_ORIGIN=

# Server-side integration-test seam for the upstream API.
# @public @optional @type=url(allowedProtocols=[http, https])
TMDB_API_URL_OVERRIDE=

# Request log verbosity; `silent` turns request logging off.
# @public @type=enum(trace, debug, info, warn, error, silent)
LOG_LEVEL=info

# Optional for TMDB-only local previews; use the same database as web for fuzzy search.
# @optional @type=url(allowedProtocols=[postgres, postgresql])
DATABASE_URL=

# Maximum database connections per API instance.
# @public @type=number(integer=true, min=1, max=100)
DB_POOL_MAX=3
