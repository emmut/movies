# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# TMDB API read access token; never sent to native clients.
# @type=string(minLength=1, matches=regex("[A-Za-z0-9]"))
MOVIE_DB_ACCESS_TOKEN=

# @public @type=port(min=1)
PORT=3001

# Optional locally; production browser consumers must supply their exact origin.
# @public @optional @type=url(allowedProtocols=[http, https], matches=regex("^https?://[^/?#@]+/?$"))
CORS_ORIGIN=

# Server-side integration-test seam for the upstream API.
# @public @optional @type=url(allowedProtocols=[http, https])
TMDB_API_URL_OVERRIDE=

# Request log verbosity; `silent` turns request logging off.
# @public @type=enum(trace, debug, info, warn, error, silent)
LOG_LEVEL=info

# Optional for TMDB-only local previews; use the same database as web for fuzzy search and account preferences.
# @required=if(forEnv(production), true, not(isEmpty($BETTER_AUTH_URL))) @type=url(allowedProtocols=[postgres, postgresql])
DATABASE_URL=

# Maximum database connections per API instance.
# @public @type=number(integer=true, min=1, max=100)
DB_POOL_MAX=3

# Public auth origin. Keep the existing web origin to preserve cookies, OAuth callbacks and passkeys.
# Next proxies /api/auth/* to this server. Optional only for catalog-only local previews.
# @public @required=if(forEnv(production), true, not(isEmpty($WEB_URL))) @type=url(allowedProtocols=[http, https], matches=regex("^https?://[^/?#@]+/?$"))
BETTER_AUTH_URL=

# Preserve the existing session signing key when moving auth from web.
# @required=if(forEnv(production), true, not(isEmpty($BETTER_AUTH_URL))) @type=string(minLength=32)
BETTER_AUTH_SECRET=

# @public @optional @type=url(allowedProtocols=[http, https])
BETTER_AUTH_TRUSTED_ORIGIN=

# Only enable for local browser tests creating many anonymous sessions.
# @public @type=boolean
AUTH_RATE_LIMIT_DISABLED=false

# @public @required=not(isEmpty($BETTER_AUTH_URL)) @type=string(minLength=1)
DISCORD_CLIENT_ID=

# @required=not(isEmpty($BETTER_AUTH_URL)) @type=string(minLength=1)
DISCORD_CLIENT_SECRET=

# @public @required=not(isEmpty($BETTER_AUTH_URL)) @type=string(minLength=1)
GITHUB_CLIENT_ID=

# @required=not(isEmpty($BETTER_AUTH_URL)) @type=string(minLength=1)
GITHUB_CLIENT_SECRET=

# Same public fingerprints as web's association endpoint.
# @public @optional @type=string(matches=regex("^ *(?:[A-Fa-f0-9]{2}:?){31}[A-Fa-f0-9]{2}(?: *, *(?:[A-Fa-f0-9]{2}:?){31}[A-Fa-f0-9]{2})* *$"))
PASSKEY_ANDROID_FINGERPRINTS=

# Railway public ingress overwrites X-Real-IP. Direct hosts use the socket peer; never trust arbitrary IP headers.
# @public @type=enum(socket, railway)
AUTH_IP_SOURCE=socket

# Web proxy and cache-event signing key. Must match web BETTER_AUTH_SECRET.
# @required=if(forEnv(production), true, not(isEmpty($BETTER_AUTH_URL))) @type=string(minLength=32)
AUTH_PROXY_SECRET=

# Next cache invalidation destination (normally the web origin).
# @public @optional @type=url(allowedProtocols=[http, https])
WEB_URL=
