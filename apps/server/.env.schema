# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# TMDB API read access token; never sent to native clients.
# @type=string(minLength=1, matches=regex("[A-Za-z0-9]"))
MOVIE_DB_ACCESS_TOKEN=

# @public @type=port(min=1)
PORT=3001

# Optional locally; production browser consumers must supply their exact origin.
# @public @optional @type=url(allowedProtocols=[http, https], matches=regex("^https?://[^/?#@]+/?$"))
CORS_ORIGIN=

# Server-side integration-test seam for the upstream API.
# @public @optional @type=url(allowedProtocols=[http, https])
TMDB_API_URL_OVERRIDE=

# Request log verbosity; `silent` turns request logging off.
# @public @type=enum(trace, debug, info, warn, error, silent)
LOG_LEVEL=info

# Optional for TMDB-only local previews; use the same database as web for fuzzy search and account preferences.
# @optional @type=url(allowedProtocols=[postgres, postgresql])
DATABASE_URL=

# Maximum database connections per API instance.
# @public @type=number(integer=true, min=1, max=100)
DB_POOL_MAX=3

# Canonical web auth service; preserves existing sessions, providers and anonymous migration.
# @public @optional @type=url(allowedProtocols=[http, https], matches=regex("^https?://[^/?#@]+/?$"))
AUTH_URL=

# Railway public ingress overwrites X-Real-IP. Direct hosts use the socket peer; never trust arbitrary IP headers.
# @public @type=enum(socket, railway)
AUTH_IP_SOURCE=socket

# Auth metadata signing key; Railway references the canonical web auth secret.
# @optional @type=string(minLength=32)
AUTH_PROXY_SECRET=
