# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# TMDB read access token; remains server-only.
# @type=string(minLength=1)
MOVIE_DB_ACCESS_TOKEN=

# Server-side integration-test override for TMDB.
# @public @dynamic @optional @type=url(allowedProtocols=[http, https])
TMDB_API_URL_OVERRIDE=

# @type=string(minLength=1)
BETTER_AUTH_SECRET=

# @public @dynamic @optional @type=string(minLength=1)
BETTER_AUTH_TRUSTED_ORIGIN=

# @type=url(allowedProtocols=[postgres, postgresql])
DATABASE_URL=

# Maximum connections per web instance; keep low for serverless deployments.
# @public @dynamic @type=number(min=1, isDivisibleBy=1)
DB_POOL_MAX=3

# Only enable for local browser tests that create many anonymous sessions.
# @public @dynamic @type=boolean
AUTH_RATE_LIMIT_DISABLED=false

# @type=string(minLength=1)
DISCORD_CLIENT_ID=

# @type=string(minLength=1)
DISCORD_CLIENT_SECRET=

# @type=string(minLength=1)
GITHUB_CLIENT_ID=

# @type=string(minLength=1)
GITHUB_CLIENT_SECRET=

# Hex-encoded signing key and salt, shared with the imgproxy service.
# @type=string(minLength=1)
IMGPROXY_KEY=

# @type=string(minLength=1)
IMGPROXY_SALT=

# Vercel supplies hostnames; auth converts these to HTTPS origins.
# @public @dynamic @optional @type=string(minLength=1)
VERCEL_BRANCH_URL=

# @public @dynamic @optional @type=string(minLength=1)
VERCEL_PROJECT_PRODUCTION_URL=

# Native passkey association identifiers are public deployment metadata.
# @public @dynamic @optional @type=string(matches=regex("^[A-Z0-9]{10}$"))
PASSKEY_APPLE_TEAM_ID=

# Comma-separated SHA-256 fingerprints, as hex or colon-separated pairs.
# @public @dynamic @optional @type=string(matches=regex("^ *(?:[A-Fa-f0-9]{2}:?){31}[A-Fa-f0-9]{2}(?: *, *(?:[A-Fa-f0-9]{2}:?){31}[A-Fa-f0-9]{2})* *$"))
PASSKEY_ANDROID_FINGERPRINTS=

# Browser configuration must be explicitly public; no secrets belong here.
# @public @type=url(allowedProtocols=[http, https])
NEXT_PUBLIC_IMGPROXY_ENDPOINT=

# @public @type=url(allowedProtocols=[http, https])
NEXT_PUBLIC_IMGPROXY_BASE_URL=

# @public @type=string(minLength=1)
NEXT_PUBLIC_POSTHOG_KEY=

# @public @type=string(minLength=1)
NEXT_PUBLIC_POSTHOG_HOST=

# @public @type=url(allowedProtocols=[http, https])
NEXT_PUBLIC_BASE_URL=

# Standalone cron scripts read the same .env file; web does not execute these jobs.
# @public @optional @type=boolean
TITLE_SYNC_ENABLED=false

# @public @optional @type=boolean
SEARCH_INDEX_INGEST_ENABLED=false

# Internal product API origin; production must supply its own service URL.
# @type=url(allowedProtocols=[http, https], matches=regex("^https?://[^/?#@]+/?$"))
API_URL=if(not(forEnv(production)), http://localhost:3001)

# Trust X-Real-IP only when Railway overwrites it at public ingress.
# @public @dynamic @type=enum(none, railway)
RPC_IP_SOURCE=none
