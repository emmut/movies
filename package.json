{
  "name": "movies",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nub run dev:docker:up && nub exec turbo run dev --cache-dir=.turbo/cache",
    "dev:docker:up": "docker compose -f docker-compose.dev.yml up -d",
    "dev:docker:down": "docker compose -f docker-compose.dev.yml down",
    "build": "nub run lint && nub exec turbo run build --filter=@movies/web --cache-dir=.turbo/cache",
    "start": "nub run --node --filter @movies/web start",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:install": "playwright install --with-deps chromium webkit",
    "fallow": "fallow audit",
    "fallow:dead-code": "fallow dead-code",
    "format": "oxfmt --write apps packages scripts",
    "format:check": "oxfmt --check apps packages scripts",
    "db": "nub --env-file-if-exists=apps/web/.env exec drizzle-kit",
    "db:generate": "nub --env-file-if-exists=apps/web/.env exec drizzle-kit generate",
    "db:migrate": "nub --env-file-if-exists=apps/web/.env exec drizzle-kit migrate",
    "db:migrate:railway": "nub --env-file-if-exists=apps/web/.env scripts/migrate-with-db-wait.ts",
    "db:push": "nub --env-file-if-exists=apps/web/.env exec drizzle-kit push",
    "db:studio": "nub --env-file-if-exists=apps/web/.env exec drizzle-kit studio",
    "seed": "nub --env-file=apps/web/.env scripts/seed-watchlist-and-lists.ts",
    "ingest:imdb": "nub --env-file-if-exists=apps/web/.env scripts/ingest-imdb-ratings.ts",
    "sync:titles": "nub --env-file-if-exists=apps/web/.env scripts/sync-titles.ts",
    "ingest:search": "nub --env-file-if-exists=apps/web/.env scripts/ingest-search-index.ts",
    "list-providers": "nub --env-file-if-exists=apps/web/.env scripts/list-watch-providers.ts",
    "check-types": "tsc --noEmit && nub run --filter @movies/web --filter @movies/native --filter @movies/server check-types",
    "dev:native": "nub run --filter @movies/native dev",
    "dev:api": "nub run --filter @movies/server dev",
    "env:generate": "varlock codegen --path ./apps/native/ && varlock codegen --path ./apps/server/",
    "postinstall": "nub run env:generate"
  },
  "dependencies": {
    "@base-ui/react": "catalog:",
    "@better-auth/passkey": "catalog:",
    "@dnd-kit/core": "catalog:",
    "@dnd-kit/sortable": "catalog:",
    "@dnd-kit/utilities": "catalog:",
    "@imgproxy/imgproxy-js-core": "catalog:",
    "@imgproxy/imgproxy-node": "catalog:",
    "@movies/api": "workspace:*",
    "@movies/db": "workspace:*",
    "@primer/octicons-react": "catalog:",
    "@t3-oss/env-nextjs": "catalog:",
    "@tailwindcss/postcss": "catalog:",
    "@tanstack/react-query": "catalog:",
    "babel-plugin-react-compiler": "catalog:",
    "better-auth": "catalog:",
    "class-variance-authority": "catalog:",
    "cn": "catalog:",
    "csv-parse": "^7.0.2",
    "drizzle-orm": "catalog:",
    "lucide-react": "catalog:",
    "next": "catalog:",
    "nuqs": "catalog:",
    "pg": "catalog:",
    "postcss": "catalog:",
    "posthog-js": "catalog:",
    "posthog-node": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "sonner": "catalog:",
    "tailwindcss": "catalog:",
    "tailwindcss-animate": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@nubjs/nub": "0.2.10",
    "@playwright/test": "catalog:",
    "@tanstack/react-query-devtools": "^5.102.8",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitest/coverage-v8": "^5.0.0",
    "drizzle-kit": "^0.31.10",
    "eslint-plugin-better-tailwindcss": "^4.7.0",
    "fallow": "3.25.0",
    "oxfmt": "^0.67.0",
    "oxlint": "^1.82.0",
    "oxlint-tsgolint": "^7.0.2001",
    "railway": "3.10.0",
    "shadcn": "^4.21.0",
    "turbo": "2.11.7",
    "typescript": "catalog:",
    "varlock": "catalog:",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": "24.x"
  },
  "packageManager": "pnpm@11.1.2+sha512.415a1cc25974731e75455c1468371be74c5aa5fb7621b50d4056d222451609f11412f23fd602e6169f1e060466641f798597e1be961a10688836a67b16569499",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@nubjs/nub",
      "better-sqlite3",
      "core-js",
      "esbuild",
      "msw",
      "sharp",
      "unrs-resolver"
    ]
  }
}
