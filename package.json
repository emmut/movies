{
  "name": "movies",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp run dev:docker:up && vp exec -- turbo run dev --filter=@movies/web --cache-dir=.turbo/cache",
    "dev:docker:up": "docker compose -f docker-compose.dev.yml up -d",
    "dev:docker:down": "docker compose -f docker-compose.dev.yml down",
    "build": "vp run lint && vp exec -- turbo run build --filter=@movies/web --cache-dir=.turbo/cache",
    "start": "vp run @movies/web#start",
    "lint": "vp lint .",
    "check": "vp check",
    "lint:fix": "vp lint --fix .",
    "test": "vp test run",
    "test:watch": "vp test watch",
    "test:coverage": "vp test run --coverage",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:install": "playwright install --with-deps chromium webkit",
    "fallow": "fallow audit",
    "fallow:dead-code": "fallow dead-code",
    "format": "vp fmt --write",
    "format:check": "vp fmt --check",
    "db": "node --env-file-if-exists=apps/web/.env ./node_modules/drizzle-kit/bin.cjs",
    "db:generate": "node --env-file-if-exists=apps/web/.env ./node_modules/drizzle-kit/bin.cjs generate",
    "db:migrate": "node --env-file-if-exists=apps/web/.env ./node_modules/drizzle-kit/bin.cjs migrate",
    "db:migrate:railway": "vpx --env-file-if-exists=apps/web/.env scripts/migrate-with-db-wait.ts",
    "db:push": "node --env-file-if-exists=apps/web/.env ./node_modules/drizzle-kit/bin.cjs push",
    "db:studio": "node --env-file-if-exists=apps/web/.env ./node_modules/drizzle-kit/bin.cjs studio",
    "seed": "vpx --env-file=apps/web/.env scripts/seed-watchlist-and-lists.ts",
    "ingest:imdb": "vpx --env-file-if-exists=apps/web/.env scripts/ingest-imdb-ratings.ts",
    "sync:titles": "vpx --env-file-if-exists=apps/web/.env scripts/sync-titles.ts",
    "ingest:search": "vpx --env-file-if-exists=apps/web/.env scripts/ingest-search-index.ts",
    "list-providers": "vpx --env-file-if-exists=apps/web/.env scripts/list-watch-providers.ts",
    "check-types": "tsc --noEmit && vp exec -- turbo run check-types --filter=@movies/web --cache-dir=.turbo/cache"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@better-auth/passkey": "^1.7.4",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@imgproxy/imgproxy-js-core": "^1.9.0",
    "@imgproxy/imgproxy-node": "^1.1.0",
    "@movies/db": "workspace:*",
    "@primer/octicons-react": "^19.35.0",
    "@t3-oss/env-nextjs": "^0.13.11",
    "@tailwindcss/postcss": "^4.3.3",
    "@tanstack/react-query": "^5.102.8",
    "babel-plugin-react-compiler": "1.0.0",
    "better-auth": "^1.7.4",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.2.6",
    "csv-parse": "^7.0.3",
    "drizzle-orm": "^0.45.3",
    "lucide-react": "^1.49.0",
    "next": "16.3.6",
    "nuqs": "^2.10.1",
    "pg": "^8.23.0",
    "postcss": "8.5.28",
    "posthog-js": "^1.430.2",
    "posthog-node": "^5.52.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sonner": "^2.0.8",
    "tailwindcss": "4.3.3",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tanstack/react-query-devtools": "^5.102.8",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.13.4",
    "@types/pg": "^8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "catalog:",
    "drizzle-kit": "^0.31.10",
    "eslint-plugin-better-tailwindcss": "^4.7.0",
    "fallow": "3.25.0",
    "railway": "3.10.0",
    "shadcn": "^4.21.0",
    "turbo": "2.11.7",
    "typescript": "7.0.2",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": "24.x"
  },
  "packageManager": "pnpm@12.15.0+sha512.b3951d6d6ff4a9f13dc7cf56cd28d2b8eb37dbcc9c68e52e1e1191873ea9f82a017287ab50baadc5ccc494f036c67c0e47eb13608c2fa36f47711b61ea128e61"
}
