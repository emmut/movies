{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./apps/web/src/*"],
      "@native/*": ["./apps/native/*"],
      "@server/*": ["./apps/server/src/*"]
    },
    "allowImportingTsExtensions": true
  },
  "include": [
    "apps/web/src/**/*.ts",
    "apps/web/src/**/*.tsx",
    "apps/web/next.config.ts",
    "packages/**/*.ts",
    "packages/**/*.tsx",
    "scripts/**/*.ts",
    "e2e/**/*.ts",
    "drizzle.config.ts",
    "vitest.config.ts",
    "playwright.config.ts",
    ".railway/railway.ts"
  ],
  "exclude": ["node_modules"]
}
